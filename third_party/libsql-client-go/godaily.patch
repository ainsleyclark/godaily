+// WithHTTPClient sets the HTTP client used for http:// and https:// URLs.
+// Without it the driver uses http.DefaultClient. (godaily fork.)
+func WithHTTPClient(client *nethttp.Client) Option {
+	return option(func(o *config) error {
+		if o.httpClient != nil {
+			return fmt.Errorf("httpClient already set")
+		}
+		if client == nil {
+			return fmt.Errorf("httpClient must not be nil")
+		}
+		o.httpClient = client
+		return nil
+	})
+}
